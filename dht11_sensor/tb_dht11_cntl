// 26.05.01 16:02

`timescale 1ns / 1ps

module tb_dht11_cntl ();
    // 시뮬레이션 파라미터
    parameter [7:0] HUMI_INT = 8'd60;  // 습도 정수부
    parameter [7:0] TEMP_INT = 8'd25;  // 온도 정수부
    parameter [39:0] DATA_STREAM = {
        HUMI_INT, 8'h00, TEMP_INT, 8'h00, HUMI_INT + TEMP_INT
    };
    reg clk;
    reg rst;
    reg btn_start;

    reg dht_sensor_data; // sensor에서 넣어주는 거 sync low 구간이 지난 다음에 들어가야함
    reg io_oe;

    wire o_led15;
    wire [7:0] humidity, temparature;
    wire valid;

    wire dht11;
    wire w_tick_us;

    // tb io mode 변환.
    assign dht11 = (io_oe) ? dht_sensor_data : 1'bz;
    // inout 이여서 wire로 해야함 
    // 반대쪽에서 false release (wire에서 강제 입력)
    // 센서 입장에서 io 제어 필요

    tick_gen_us dut2 (
        .clk(clk),
        .rst(rst),
        .tick_us(w_tick_us)
    );

    dht11_controller dut (
        .clk            (clk),
        .rst            (rst),
        .dht11_start    (btn_start),
        .tick_us        (w_tick_us),
        .humidity       (humidity),
        .temperature    (temparature),
        .valid          (valid),
        .o_led15        (o_led15),
        .dht11          (dht11)
    );

    always #5 clk = ~clk;

    integer i = 0;

    initial begin
        clk = 0;
        rst = 1;
        io_oe = 0;
        btn_start = 0;

        #100;
        rst = 0;
        #100;
        btn_start = 1;
        #100;
        btn_start = 0;
        #100;
        wait (!dht11);
        // 18msec 대기
        wait (dht11);


        // x 나 z 뜰 수도 있음
        #30000;
        // 입력 모드로 변환
        io_oe = 1;
        //

        dht_sensor_data = 1'b0;
        #80000;
        dht_sensor_data = 1'b1;
        #80000;


        // 내가 만든 데이터 넣어서 확인
        for (i = 39; i >= 0; i = i - 1) begin
            dht_sensor_data = 0;
            #50000;
            dht_sensor_data = 1'b1;
            #(DATA_STREAM[i] ? 70000 : 26000);
        end
        dht_sensor_data = 0;
        #50000;
        //

        // 일부로 다시 연결 끊음
        io_oe = 0;
        #50000;
        $stop;
    end

endmodule
